# ── Embeddings ──────────────────────────────────────────────────
# VOYAGE_API_KEY (optional)
# Voyage AI key for real semantic embeddings. Without it, doks falls
# back to a deterministic hash embedder — fine for local dev, not for
# production retrieval.
# Get a key: https://www.voyageai.com/
# VOYAGE_API_KEY=

# ── Chat providers (optional) ───────────────────────────────────
# At least one chat provider key is needed for the "Ask the docs"
# panel to work. All are optional — the panel gracefully degrades if
# none is set.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=

# ── Deployment ──────────────────────────────────────────────────
# NODE_ENV (set automatically by your hosting platform)
# Set to "production" in production deployments.
# NODE_ENV=production
