{
  "name": "doks-core",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "doks": "./bin/doks.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./src/styles/globals.css",
    "./mdx-components": "./dist/mdx-components.jsx",
    "./api/search": "./dist/api/searchRoute.js",
    "./scripts/ingest": "./dist/scripts/ingest.js",
    "./not-found": "./dist/pages/notFoundPage.jsx",
    "./error": "./dist/pages/errorPage.jsx",
    "./global-error": "./dist/pages/globalErrorPage.jsx",
    "./adapters/sqlite": "./dist/adapters/sqlite/index.js",
    "./adapters/d1": "./dist/adapters/d1/index.js"
  },
  "description": "Framework engine for doks — Next.js + MDX docs with built-in RAG retrieval.",
  "keywords": [
    "docs",
    "documentation",
    "rag",
    "mdx",
    "nextjs",
    "embeddings",
    "sqlite-vec",
    "ai"
  ],
  "homepage": "https://github.com/getdoks/doks",
  "repository": {
    "type": "git",
    "url": "https://github.com/getdoks/doks.git",
    "directory": "packages/doks-core"
  },
  "bugs": {
    "url": "https://github.com/getdoks/doks/issues"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/styles",
    "bin",
    "migrations",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.0.3",
    "@types/mdx": "^2.0.13",
    "better-sqlite3": "^11.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next-mdx-remote": "^6.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sqlite-vec": "^0.1.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11"
  },
  "scripts": {
    "build": "tsc && node scripts/fix-extensions.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js test/adapters/*.test.js",
    "prepack": "tsc && node scripts/fix-extensions.mjs"
  }
}
