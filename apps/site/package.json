{
  "name": "@doks/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "doks build:content && doks ensure-index",
    "prebuild": "doks build:content",
    "dev": "concurrently --kill-others-on-fail --names \"NEXT,MDX\" --prefix-colors \"cyan,magenta\" \"npm:dev:next\" \"npm:dev:content\"",
    "dev:next": "next dev --turbopack",
    "dev:content": "doks build:content --watch",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "ingest": "tsx ../../packages/doks-core/src/scripts/ingest.ts"
  },
  "dependencies": {
    "doks-core": "*",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
